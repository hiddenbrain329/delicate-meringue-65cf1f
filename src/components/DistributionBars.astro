---
interface Props {
  distribution: number[]; // 10 buckets, index 0 = score 1
  surface?: "dark" | "cream";
}

const { distribution, surface = "cream" } = Astro.props;
const max = Math.max(...distribution, 1);
const total = distribution.reduce((a, b) => a + b, 0);
const barColor = surface === "cream" ? "#cc2f6c" : "#f172a3";
const trackColor = surface === "cream" ? "#f6d6d2" : "#ffffff1a";
const textColor = surface === "cream" ? "text-ink-950/60" : "text-cream-100/60";
---

<div>
  <div class="flex items-end gap-1.5 h-28" role="img" aria-label={`Distribution of ${total} quality ratings, scores 1 through 10`}>
    {distribution.map((count, i) => {
      const pct = Math.max(3, Math.round((count / max) * 100));
      return (
        <div class="flex-1 flex flex-col items-center justify-end gap-1">
          <div class="w-full rounded-t-sm" style={`height:${pct}%; background:${trackColor};`}>
            <div class="w-full h-full rounded-t-sm" style={`background:${barColor};`}></div>
          </div>
          <span class={`text-[10px] font-medium ${textColor}`}>{i + 1}</span>
        </div>
      );
    })}
  </div>
  <details class="mt-3">
    <summary class={`cursor-pointer text-xs ${textColor} hover:underline`}>View as table</summary>
    <table class="mt-2 w-full text-xs">
      <caption class="sr-only">Number of ratings per quality score, 1 to 10</caption>
      <thead>
        <tr class={textColor}>
          <th scope="col" class="text-left font-medium">Score</th>
          <th scope="col" class="text-left font-medium">Ratings</th>
        </tr>
      </thead>
      <tbody>
        {distribution.map((count, i) => (
          <tr>
            <td class="py-0.5">{i + 1}</td>
            <td class="py-0.5">{count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</div>
