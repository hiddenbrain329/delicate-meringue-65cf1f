---
import Layout from "../../layouts/Layout.astro";
import { songs } from "../../data/songs";

const embedded = songs.filter((s) => s.video);
---

<Layout title="Videos" description="Official Red Velvet music videos, performances, and content — embedded from the official channels.">
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16">
    <p class="text-xs font-medium uppercase tracking-wide text-cream-100/50">Videos</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-cream-50 sm:text-4xl">Official video, in one place.</h1>
    <p class="mt-3 max-w-2xl text-cream-100/65">
      The full videos hub — auto-pulling MVs, performances, variety, and vlogs from the official
      SMTOWN and Red Velvet channels — is coming in the next phase. For now, here's official video
      already embedded on song pages.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {embedded.map((song) => (
        <a href={`/music/${song.slug}`} class="block overflow-hidden rounded-2xl border border-white/10 bg-velvet-900/60 hover:border-white/25">
          <div class="aspect-video w-full bg-black">
            <img
              src={`https://i.ytimg.com/vi/${song.video!.id}/hqdefault.jpg`}
              alt={`${song.title} video thumbnail`}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <p class="font-semibold text-cream-50">{song.title}</p>
            <p class="text-sm text-cream-100/50">{song.artist} · {song.era}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-dashed border-white/15 p-8 text-center">
      <p class="font-display text-lg text-cream-50">Full video hub coming soon</p>
      <p class="mt-2 text-sm text-cream-100/55">
        Planned: automatic sync via the YouTube Data API / channel RSS, categorized as MV, performance,
        variety, and vlog. See the project roadmap for details.
      </p>
    </div>
  </section>
</Layout>
